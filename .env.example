# =========================================================
# 云崩铁每日自动化 · 配置示例
# 用法：cp .env.example .env 然后按需修改
# 注意：注释必须单独成行；= 后面只写值，不要跟 # 注释
# =========================================================

# ============ 浏览器（必须） ============
GAME_URL=https://sr.mihoyo.com/cloud/#/

# chromedriver 路径。留空 = 让 Selenium 自动下载（需联网）
CHROMEDRIVER_PATH=/usr/local/bin/chromedriver

# Chrome/Chromium 可执行文件路径。留空 = 使用 Selenium 默认（google-chrome）
CHROME_BINARY=

# Chrome 用户数据目录（登录态），首次登录后请持久化此目录
CHROME_USER_DATA_DIR=chrome_profile

# ============ 运行模式 ============
# true  = 只启动浏览器，供 VNC 手动登录，不执行自动化
# false = 正常自动化流程
LOGIN_ONLY=false

# ============ X11 点击 ============
# Chrome 顶栏高度补偿：屏幕坐标 Y = 截图坐标 Y + 此值
# 默认 139 仅适用于无书签栏、100% 缩放、窗口位于 (0,0) 的默认情况
# 点击整体偏上就调大，偏下就调小，详见 README「Y 轴补偿」
Y_OFFSET=139

# ============ X / VNC ============
DISPLAY=:99
USE_VNC=true
VNC_PORT=5900
WINDOW_W=1920
WINDOW_H=1080

# ============ 模板图片 ============
TEMPLATE_UPDATES=capture/updates.png
TEMPLATE_START=capture/start.png
TEMPLATE_COIN=capture/coin.png
TEMPLATE_LOADING=capture/loading.png
TEMPLATE_ACCEPT=capture/accept.png
TEMPLATE_DONE=capture/completed.png

# ============ 匹配 / 调试 ============
DEBUG_DIR=debug
THRESHOLD=0.6
POLL_INTERVAL=0.5

# ============ 超时（秒） ============
TIMEOUT_STEP1=30
QUICK_TIMEOUT=10
LOADING_TIMEOUT=120
TIMEOUT_COMPLETED=180
RANDOM_CLICK_DURATION=60

# ============ 挂机 / 点击 ============
HANG_TIME_MIN=18
HANG_TIME_MAX=22
CLICK_CENTER_TIMES=3
CLICK_CENTER_INTERVAL=3.0
CLICK_WAIT_MIN=1.5
CLICK_WAIT_MAX=2.5

# =========================================================
# 可选：AstrBot 通知
# 三个字段都填则自动启用；不填则跳过通知
# =========================================================
ASTRBOT_BASE_URL=
ASTRBOT_API_KEY=
ASTRBOT_UMO=

# =========================================================
# 可选：Webhook 上报
# 填了 WEBHOOK_URL 则自动启用；不填则跳过上报
# =========================================================
WEBHOOK_URL=
WEBHOOK_AUTH_KEY=

# 可选：附加 JSON 字段，会 merge 到上报 payload
# 例如：{"game":"sr","region":"cn"}
WEBHOOK_EXTRA_JSON=