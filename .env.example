# ============ 浏览器（必须） ============
GAME_URL=https://sr.mihoyo.com/cloud/#/
CHROMEDRIVER_PATH=/usr/bin/chromedriver     # 留空则让 Selenium 自动下载
CHROME_USER_DATA_DIR=chrome_profile         # 登录态目录，请持久化

# ============ X11 点击 ============
# Chrome 顶栏高度补偿，截图坐标 + 此值 = 屏幕坐标
# 默认 139 仅适用于无书签栏、100% 缩放、窗口位于 (0,0) 的情况
# 点击整体偏上就调大，偏下就调小，详见 README
Y_OFFSET=139

# ============ X / VNC ============
DISPLAY=:99
USE_VNC=true                                # 首次登录需要
VNC_PORT=5900
WINDOW_W=1920
WINDOW_H=1080

# ============ 模板图片 ============
TEMPLATE_UPDATES=capture/updates.png
TEMPLATE_START=capture/start.png
TEMPLATE_COIN=capture/coin.png
TEMPLATE_LOADING=capture/loading.png
TEMPLATE_ACCEPT=capture/accept.png
TEMPLATE_DONE=capture/completed.png

# ============ 匹配 / 调试 ============
DEBUG_DIR=debug
THRESHOLD=0.6                               # 匹配阈值，调低更宽松
POLL_INTERVAL=0.5

# ============ 超时（秒） ============
TIMEOUT_STEP1=30
QUICK_TIMEOUT=10
LOADING_TIMEOUT=120
TIMEOUT_COMPLETED=180
RANDOM_CLICK_DURATION=60

# ============ 挂机 / 点击 ============
HANG_TIME_MIN=18
HANG_TIME_MAX=22
CLICK_CENTER_TIMES=3
CLICK_CENTER_INTERVAL=3.0
CLICK_WAIT_MIN=1.5
CLICK_WAIT_MAX=2.5

# ============ 可选：AstrBot 通知（三字段都填则启用） ============
ASTRBOT_BASE_URL=
ASTRBOT_API_KEY=
ASTRBOT_UMO=

# ============ 可选：Webhook 上报（填 URL 则启用） ============
WEBHOOK_URL=
WEBHOOK_AUTH_KEY=
WEBHOOK_EXTRA_JSON=